# ============================================
# LEAF-BOSS 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# SMTP 邮箱授权码（QQ 邮箱）
# 获取方式：QQ 邮箱 → 设置 → 账户 → 开启 SMTP 服务 → 生成授权码
SMTP_PASSWORD=your_smtp_authorization_code_here

# 数据库密码（可选，默认 123456）
SPRING_DATASOURCE_PASSWORD=123456

# JWT 配置（可选，有默认值）
# APP_JWT_SECRET=your_base64_encoded_secret_here
# APP_JWT_EXPIRATION=7200000
# APP_JWT_RENEW_THRESHOLD=1800000
# APP_JWT_MAX_AGE=604800000
